{
  "identifier": "pin-window",
  "description": "Capability for the pinned screenshot floating window",
  "windows": ["pin-*"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:window:allow-start-dragging",
    "core:window:allow-close"
  ]
}
