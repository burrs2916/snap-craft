<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      SnapCraft · 直接分发 / 开发者 ID + 公证 用 entitlements（非沙箱）
      ------------------------------------------------------------------
      本文件被 src-tauri/tauri.conf.json 的 bundle.macOS.entitlements 引用，
      是 macOS `tauri build` 的必需输入（缺它构建直接失败）。

      截屏走 CoreGraphics（CGDisplayCreateImage / CGWindowListCreateImage），
      只需用户在「系统设置 → 隐私与安全 → 屏幕录制」中授权（TCC），
      与沙箱无关，不需要任何 screen-capture entitlement。

      Hardened Runtime（tauri.conf 已开）下 WebView2 / JavaScriptCore
      需要 JIT 与动态库校验豁免，以下三项为 Tauri macOS 应用的标准组合。
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
