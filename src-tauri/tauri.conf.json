{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnapCraft",
  "version": "0.2.1",
  "identifier": "com.snap-craft.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1925",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SnapCraft",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob:; connect-src 'self' https: http: ipc: http://ipc.localhost; font-src 'self' data:; media-src 'self' data:; object-src 'none'; frame-src 'none'",
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$APPDATA/**",
          "$RESOURCE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SnapCraft Lab",
    "category": "public.app-category.productivity",
    "shortDescription": "AI-first cross-platform screenshot tool with editor, OCR, and document generation",
    "longDescription": "SnapCraft is a privacy-first screenshot tool that combines full screen / region / window / scrolling capture with an editor-grade annotation suite, system-native OCR, and an AI assistant that turns your screenshots into Markdown, DOCX, PPTX, XLSX, HTML, or PDF documents — entirely on your machine by default.",
    "icon": [
      "icons/16x16.png",
      "icons/16x16@2x.png",
      "icons/32x32.png",
      "icons/32x32@2x.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/256x256@2x.png",
      "icons/512x512.png",
      "icons/512x512@2x.png",
      "icons/1024x1024.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "en.lproj",
      "zh-Hans.lproj",
      "zh-Hant.lproj",
      "ja.lproj",
      "de.lproj",
      "es.lproj"
    ],
    "externalBin": [],
    "copyright": "© 2026 SnapCraft Lab. All rights reserved.",
    "macOS": {
      "entitlements": "entitlements/app.entitlements",
      "infoPlist": "Info.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null,
      "hardenedRuntime": true,
      "minimumSystemVersion": "14.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}
