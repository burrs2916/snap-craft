    "@tauri-apps/plugin-global-shortcut": "^2",
    "docx": "^9.7.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "konva": "^10.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.14",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.12"
